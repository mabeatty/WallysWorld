{
  "manifest_version": 3,
  "name": "Auction Arbitrage Dashboard",
  "version": "0.6.0",
  "description": "Sends auction data from ebth.com and catawiki.com pages you can already see to your own dashboard.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.ebth.com/*",
    "https://www.catawiki.com/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ebth.com/*"
      ],
      "js": [
        "lib/ebth.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.catawiki.com/*"
      ],
      "js": [
        "lib/catawiki.js",
        "content-catawiki.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Auction Arbitrage Dashboard settings"
  }
}